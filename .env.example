# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# Neon Postgres connection string (Dashboard → your project → Connection string).
# Use the pooled connection string; it should end with ?sslmode=require
DATABASE_URL=

# Clerk. `npx clerk@latest init` writes these for you — you shouldn't need to
# paste them by hand.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Server-only: the Clerk user id allowed into /admin.
# No NEXT_PUBLIC_ prefix — this must never reach the browser.
ADMIN_USER_ID=
